# trade-intel — environment template
# Copy to `.env` and override only what you need.
# Real env vars (export FOO=bar) always win over .env values.

# ── App ─────────────────────────────────────────────────────────────
APP_NAME=trade-intel
ENVIRONMENT=dev            # dev | test | prod
DEBUG=false
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Database ────────────────────────────────────────────────────────
# SQLite is the dev/test default. Path is absolute, anchored to project root.
SQLITE_URL=sqlite:///./data/dev.db
# Required when ENVIRONMENT=prod. Leave unset for SQLite.
# POSTGRES_URL=postgresql+psycopg://user:pass@localhost:5432/trade_intel
DB_ECHO=false              # SQLAlchemy engine echo (verbose SQL log)

# ── ML / Vector index ───────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_TYPE=faiss    # faiss | qdrant
# FAISS_INDEX_DIR=./data/vectors

# ── API ─────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false           # true for local dev only; must be false in prod

# ── Local LLM (Ollama — NO paid APIs) ───────────────────────────────
# Shared by the Python broker and the Go broker backend (bin/broker).
LLM_ENABLED=true
OLLAMA_HOST=http://127.0.0.1:11434
# Model-agnostic. Default = llama3.2:3b: small (~2 GB), fast, no chain-of-thought
# — ideal for a CPU-only 8 GB laptop / cheap VPS. OLLAMA_MODEL wins over LLM_MODEL.
OLLAMA_MODEL=llama3.2:3b            # primary
OLLAMA_FALLBACK_MODEL=qwen3:4b     # used automatically if primary isn't pulled
# (LLM_MODEL / LLM_FALLBACK_MODEL are accepted aliases.)
LLM_NUM_CTX=2048           # context window (small = low RAM, faster first token)
LLM_NUM_PREDICT=512        # generation cap (broker replies are short)
LLM_NUM_THREAD=0           # 0 = let Ollama pick (defaults to core count)
LLM_KEEP_ALIVE=5m          # unload model after idle (frees RAM); -1 to pin
LLM_TEMPERATURE=0.3        # low temp keeps the broker grounded + terse
# Per-request wall-clock budget (seconds). CPU inference is SLOW — raise this
# on weak boxes (e.g. 600 on a ~1-2 tok/s machine).
LLM_TIMEOUT=120

# ── Redis cache (Phase 1 — speeds up repeated broker queries) ───────
# Pure-cache Redis, VPS-friendly:
#   redis-server --port 6379 --maxmemory 128mb --maxmemory-policy allkeys-lru --save ""
CACHE_ENABLED=true
REDIS_ADDR=127.0.0.1:6379
REDIS_TIMEOUT_MS=200                  # short = fast graceful fallback if Redis down
CACHE_TTL_URGENT_SEC=300              # urgent queries: 5 min
CACHE_TTL_NORMAL_SEC=900              # normal queries: 15 min
CACHE_TTL_INSIGHT_SEC=1800            # market insights: 30 min

# ── Go broker backend ───────────────────────────────────────────────
BROKER_ADDR=127.0.0.1:8088            # `bin/broker serve` listen address
# BROKER_URL=http://localhost:8088    # `trade-intel chat` connects here (HTTP/SSE)
# BROKER_MAX_HISTORY=8                # chat memory: turns kept per session
# TRADE_INTEL_TOPK=5                  # top-K suppliers per query
# TRADE_INTEL_PYTHON=.venv/bin/python # interpreter for the ML facts bridge
# TRADE_INTEL_FACTS_SCRIPT=scripts/broker_facts.py
# TRADE_INTEL_BROKER_BIN=bin/broker   # local-binary fallback path
