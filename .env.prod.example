# Copy to .env.prod on the VPS (chmod 600). NEVER commit .env.prod.
DOMAIN=trade.example.com                 # DNS A record -> VPS public IP
API_KEY=                                 # openssl rand -hex 32  (dashboard login key)
POSTGRES_PASSWORD=                       # openssl rand -hex 24
POSTGRES_USER=trade
POSTGRES_DB=trade_intel
IMPORT_UPLOADERS=Main,Yaseen
MAX_UPLOAD_MB=25
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FALLBACK_MODEL=llama3.2:3b
LLM_TIMEOUT=300
