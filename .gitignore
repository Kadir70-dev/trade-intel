*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
.Python

# ── Virtualenvs ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Test / coverage / type / lint caches ───────────────────────────
